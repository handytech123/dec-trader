# Copy this file to .env.local for local configuration. Never commit the populated file.
ATL_ENVIRONMENT=development
ATL_SYSTEM_MODE=OFFLINE_RESEARCH
ATL_NETWORK_ACCESS=disabled
ATL_LOG_LEVEL=info

# Read-only provider configuration. Include no real credential in this template.
CFIE_SOLANA_RPC_URL=
CFIE_SOLANA_WEBSOCKET_URL=
CFIE_DATABASE_URL=
PYTH_API_KEY=

# Do not add wallet material, provider credentials, RPC tokens, signed transactions,
# or production endpoints to this example file. Use a local ignored file or external secret store.
# Nansen is optional. Defaults limit the paid pilot to at most 25 credits/day and one fresh
# Smart Money request every six hours. Purchased responses are cached in PostgreSQL.
NANSEN_MAX_DAILY_CREDITS=25
NANSEN_CACHE_TTL_MINUTES=360
